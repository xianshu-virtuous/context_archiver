{
  "name": "context_archiver",
  "display_name": "上下文归档器",
  "version": "1.2.0",
  "description": "让 Bot 记得住，而且不用调工具就能想起来。按「Bot 有没有参与」判定，Bot 停口就把这段对话沉淀成 booku_memory 记忆；写入时顺手让模型吐出「什么场景下会想起这条」的触发词存进本地索引，之后每轮拿当前对话做纯本地匹配（水壶漏电 ↔ 想喝水），把该记得的自动注入上下文——存算一体，查询侧零 LLM、零 tool。也提供人物/近因/关键词/向量四条召回路线，可选在归档后清空该流上下文。默认 observer 模式（只观测不动作）。",
  "author": "Aemeath",
  "dependencies": {
    "plugins": [],
    "components": []
  },
  "include": [
    {
      "component_type": "service",
      "component_name": "context_archiver",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
      "component_name": "activity_tracker",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
      "component_name": "archive_summary_injector",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
      "component_name": "prompt_auditor",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
      "component_name": "auto_recall_injector",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
      "component_name": "action_stats",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "event_handler",
      "component_name": "input_auditor",
      "dependencies": [],
      "enabled": true
    },
    {
      "component_type": "command",
      "component_name": "archive",
      "dependencies": [],
      "enabled": true
    }
  ],
  "entry_point": "plugin.py",
  "api_version": {
